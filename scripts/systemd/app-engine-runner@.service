[Unit]
Description=Isolated app-engine command broker connection %i

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/usr/local/libexec/app-engine
Environment=PYTHONPATH=/usr/local/libexec/app-engine
ExecStart=/usr/bin/python3 -m app_engine.isolation_broker %n
StandardInput=socket
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
UMask=0077
